{
  "name": "@local/dsh-ledger",
  "version": "0.3.0",
  "description": "Personal asset ledger for DeepSeek Assistant: money, machines, GitHub repositories and API keys, with subtotals and per-save snapshots. Data stays outside the repository.",
  "type": "module",
  "license": "MIT",
  "author": "ChrisZqaq",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "assets",
    "ledger",
    "net-worth"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
